#!/bin/sh
# Runs this repo's push-triggered CI steps on each commit being pushed, and blocks the push
# if any fail, so a red check is caught here rather than on the public badge.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git push --no-verify   (and expect CI to say what this would have)
z40=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue            # deleting a branch: nothing to check
  echo "local CI on ${local_sha%"${local_sha#???????}"} ($local_ref)"
  python "$(git rev-parse --show-toplevel)/.githooks/run_ci_locally.py" "$local_sha" || status=1
done
exit $status
